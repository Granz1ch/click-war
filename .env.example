# ============================================================
#  Click War — Supabase connection (production setup)
#  ------------------------------------------------------------
#  Copy this file to `.env.local` and fill in your Supabase
#  project credentials from https://supabase.com/dashboard
#  (Project Settings -> API).
#
#  The game runs locally + on Vercel WITHOUT any of these set,
#  using a built-in file database (for local dev/preview only).
#  Once you set these, the app switches to Supabase for real
#  multi-player persistence across homes.
#
#  To set up the Supabase tables run:
#      supabase/schema.sql   (SQL Editor in Supabase dashboard)
# ============================================================

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""

# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key (server-only, DO NOT expose to the client!)
SUPABASE_SERVICE_ROLE_KEY=""

# Used to sign / verify the server session cookie. Any long random
# string. Required when running without Supabase too.
AUTH_SECRET=""

# Optional: application-level admin login. Creating an account with
# this login makes it an administrator.
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="admin"
